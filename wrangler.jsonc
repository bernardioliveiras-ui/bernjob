{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ramon-recruit-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ramon-recruit-eu",
      "database_id": "REPLACE_WITH_EU_D1_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "staging",
    "PUBLIC_APPLICATIONS_ENABLED": "false"
  }
}
