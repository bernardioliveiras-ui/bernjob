{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bern-global-mvp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bern-global-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENABLE_LEGAL_REQUESTS": "false",
    "JOBBOT_BATCH_SIZE": "8"
  }
}
