{
  "name": "bern-global-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:local": "wrangler d1 migrations apply bern-global-db --local",
    "db:remote": "wrangler d1 migrations apply bern-global-db --remote",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/jobbot.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.46.0"
  }
}
